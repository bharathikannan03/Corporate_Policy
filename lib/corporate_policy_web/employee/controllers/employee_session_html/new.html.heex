<div class="employee-login-page">
  <div class="employee-login-card">
    <div class="employee-login-shell">
      <div class="employee-login-brand">
        <div class="employee-login-logo">
          <span class="employee-brand-v">V</span> <span class="employee-brand-i">I</span>
          <span class="employee-brand-b">B</span> <span class="employee-brand-e">E</span>
        </div>

        <p>Insurance Broking and Advisory Service Pvt Ltd</p>
      </div>

      <h1 class="employee-login-title">Employee Login</h1>

      <.form for={@form} action={~p"/employee/login"} method="post" class="employee-login-form">
        <input
          type="hidden"
          name="employee_auth[action]"
          value={if @otp_sent, do: "login", else: "request_otp"}
        />
        <div>
          <label class="employee-login-label">Phone Number</label>
          <input
            type="text"
            name="employee_auth[mobile_number]"
            value={@form[:mobile_number].value || ""}
            class="employee-login-input"
            placeholder="Enter registered mobile number"
            inputmode="numeric"
            maxlength="10"
            pattern="[0-9]{10}"
            required
          />
        </div>

        <%= if @otp_sent do %>
          <div>
            <label class="employee-login-label">Enter OTP</label>
            <input
              type="text"
              name="employee_auth[otp]"
              value={@form[:otp].value || ""}
              class="employee-login-input"
              placeholder="Enter OTP"
              inputmode="numeric"
              maxlength="6"
              required
            />
          </div>
        <% end %>

        <button type="submit" class="employee-login-submit">
          {if @otp_sent, do: "Login", else: "Generate OTP"}
        </button>
      </.form>

      <p class="employee-login-note">
        Access is limited to active employee/self records mapped in the employee policy data.
      </p>
    </div>
  </div>
</div>
