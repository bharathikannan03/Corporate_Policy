      </div>
      
      <h1 class="employee-login-title">Employee Login</h1>
      
      <.form for={@form} action={~p"/employee/login"} method="post" class="employee-login-form">
        <input
          type="hidden"
          name="employee_auth[action]"
          value={if @otp_sent, do: "login", else: "request_otp"}
        />
        <div>
          <label class="employee-login-label">Phone Number</label>
          <input
            type="text"
            name="employee_auth[mobile_number]"
            value={@form[:mobile_number].value || ""}
            class="employee-login-input"
            placeholder="Enter registered mobile number"
            inputmode="numeric"
            maxlength="10"
            pattern="[0-9]{10}"
            required
          />
        </div>
        
        <%= if @otp_sent do %>
          <div>
            <label class="employee-login-label">Enter OTP</label>
            <div
              id="employee-otp-secret-field"
              class="employee-secret-field"
              phx-hook="PasswordToggle"
            >
              <input
                type="password"
                name="employee_auth[otp]"
                value={@form[:otp].value || ""}
                class="employee-login-input employee-login-input--secret"
                placeholder="Enter OTP"
                inputmode="numeric"
                maxlength="6"
                required
                data-password-toggle-target="input"
              />
              <button
                type="button"
                class="employee-secret-toggle"
                aria-label="Show OTP"
                aria-pressed="false"
                data-password-toggle-target="button"
              >
                <span data-password-toggle-target="show-icon">
                  <.icon name="hero-eye" class="w-5 h-5" />
                </span>
                <span class="hidden" data-password-toggle-target="hide-icon">
                  <.icon name="hero-eye-slash" class="w-5 h-5" />
                </span>
              </button>
            </div>
          </div>
        <% end %>
