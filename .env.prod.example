# Production Environment Variables Example

# Phoenix Server Configuration
PORT=4000
PHX_SERVER=true
PHX_HOST=your-domain.com
SECRET_KEY_BASE=your_generated_secret_key_base_using_mix_phx_gen_secret

# Database Configuration
# Format: ecto://USER:PASS@HOST/DATABASE
DATABASE_URL=ecto://postgres:postgres@localhost/corporate_policy_prod
POOL_SIZE=10
# Optional: Set to true/1 if using IPv6
# ECTO_IPV6=false

# Resend Settings
# RESEND_API_KEY=your_resend_api_key_here
# SENDER_EMAIL=no-reply@yourverifieddomain.com

# Optional SSL Settings
# SOME_APP_SSL_KEY_PATH=/path/to/ssl/key
# SOME_APP_SSL_CERT_PATH=/path/to/ssl/cert
