<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-base-200 flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-sm bg-base-100 rounded-2xl border border-base-300 shadow-xl p-8">
      <div class="mb-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary">
          Secure access
        </p>
        <h1 class="mt-2 text-xl font-bold text-base-content">Login to your account</h1>
      </div>

      <.form for={@form} id="login-form" action={~p"/login"} method="post" class="space-y-4">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <.input
          field={@form[:email_address]}
          type="email"
          label="Email address"
          placeholder="you@example.com"
          required
        />
        <.input
          field={@form[:password]}
          type="password"
          label="Password"
          placeholder="••••••••"
          required
        />
        <button type="submit" id="login-submit" class="btn btn-primary w-full mt-2">
          Sign in
        </button>
      </.form>
    </div>
  </div>
</Layouts.app>
