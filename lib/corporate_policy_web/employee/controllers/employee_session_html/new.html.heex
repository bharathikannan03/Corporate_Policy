<div class="min-h-screen flex items-center justify-center bg-slate-100 px-4">
  <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-8 shadow-xl">
    <div class="mb-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-600">
        Employee Portal
      </p>
      
      <h1 class="mt-3 text-3xl font-bold text-slate-900">Claim Submission Access</h1>
      
      <p class="mt-2 text-sm text-slate-500">
        Sign in to submit and track employee health claims.
      </p>
    </div>
    
    <.form for={@form} action={~p"/employee/login"} method="post" class="space-y-5">
      <div>
        <label class="mb-2 block text-sm font-medium text-slate-700">Email Address</label>
        <input
          type="email"
          name="user[email_address]"
          value={@form[:email_address].value || ""}
          class="w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
          placeholder="employee@corporate.com"
          required
        />
      </div>
      
      <div>
        <label class="mb-2 block text-sm font-medium text-slate-700">Password</label>
        <input
          type="password"
          name="user[password]"
          class="w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
          placeholder="Enter your password"
          required
        />
      </div>
      
      <button
        type="submit"
        class="w-full rounded-xl bg-gradient-to-r from-blue-500 to-blue-700 px-4 py-3 font-semibold text-white shadow-lg transition hover:from-blue-600 hover:to-blue-800"
      >
        Sign In
      </button>
    </.form>
  </div>
</div>
